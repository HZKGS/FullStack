( 142 |                     "rating": rating,) Tj T*
( 143 |                     "text": rng.choice\(REVIEW_PHRASES\),) Tj T*
( 144 |                     "created_at": extended_date\(review_date\),) Tj T*
( 145 |                     "updated_at": extended_date\(review_date\),) Tj T*
( 146 |                 }) Tj T*
( 147 |             \)) Tj T*
( 148 |) Tj T*
