(  23 |     if isinstance\(value, dict\):) Tj T*
(  24 |         return {str\(key\): json_safe\(item\) for key, item in value.items\(\)}) Tj T*
(  25 |     if isinstance\(value, \(list, tuple\)\):) Tj T*
(  26 |         return [json_safe\(item\) for item in value]) Tj T*
