( 130 |             rating = rng.randint\(1, 5\)) Tj T*
( 131 |             ratings.append\(rating\)) Tj T*
( 132 |             review_date = created_at + timedelta\() Tj T*
( 133 |                 days=10 + review_index * 17,) Tj T*
( 134 |                 hours=rng.randint\(8, 20\),) Tj T*
( 135 |             \)) Tj T*
( 136 |             review_number = business_index * REVIEWS_PER_BUSINESS + review_index) Tj T*
( 137 |             reviews.append\() Tj T*
( 138 |                 {) Tj T*
